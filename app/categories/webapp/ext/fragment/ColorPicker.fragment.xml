<core:FragmentDefinition
    xmlns:core="sap.ui.core"
    xmlns="sap.m">

    <HBox alignItems="Center">
        <Input
            value="{color}"
            width="12rem" />

        <Button
            icon="sap-icon://palette"
            type="Transparent"
            core:require="{
                handler: 'expense/tracker/categories/ext/fragment/ColorPicker'
            }"
            press="handler.onOpenColorPicker" />
    </HBox>

</core:FragmentDefinition>