{
  "name": "ExpenseTracker",
  "version": "1.0.0",
  "dependencies": {
    "@cap-js/mcp": "^1.4.3",
    "@cap-js/mcp-server": "^0.0.5",
    "@sap/cds": "^9"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^2.4.1",
    "cds-plugin-ui5": "^0.17.0"
  },
  "scripts": {
    "start": "cds-serve",
    "watch-transactions": "cds watch --open expense.tracker.transactions/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-categories": "cds watch --open expense.tracker.categories/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-budget": "cds watch --open expense.tracker.budget/index.html?sap-ui-xx-viewCache=false --livereload false"
  },
  "private": true,
  "cds": {
    "requires": {
      "db": {
        "[development]": {
          "kind": "sqlite",
          "credentials": {
            "url": "db.sqlite"
          }
        }
      }
    }
  },
  "workspaces": [
    "app/*"
  ],
  "sapux": [
    "app/transactions",
    "app/categories",
    "app/budget"
  ]
}
